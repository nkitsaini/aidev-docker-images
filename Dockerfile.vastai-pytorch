# syntax=docker/dockerfile:1.7

# The locked PyTorch wheels include the CUDA 13 runtime libraries they need.
# A CUDA devel image would duplicate those libraries and add a toolkit that this
# project does not use. Keep an explicit, dated Vast tag so builds are repeatable.
FROM vastai/base-image:stock-ubuntu24.04-py314-2026-08-06

ENV DEBIAN_FRONTEND=noninteractive \
    UV_NO_CACHE=0 \
    UV_LINK_MODE=copy

# curl and git are already provided by the Vast base image. Ubuntu 24.04 also
# packages sd, so all additional command-line tools can share one small layer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fzf \
        mosh \
        ripgrep \
        sd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Populate uv's persistent cache with the exact project lock. The throwaway
# environment is created and removed in the same layer, so only reusable cache
# artifacts remain in the final image. clone is safe and fast here because the
# environment and cache are on the same filesystem; runtime installs retain
# copy mode for compatibility with a mounted /workspace.
RUN --mount=type=bind,source=pylock.toml,target=/tmp/pylock.toml,readonly \
    uv venv --python /venv/main/bin/python /tmp/cache-warm-venv \
    && UV_LINK_MODE=clone uv pip install \
        --no-verify-hashes \
        --python /tmp/cache-warm-venv \
        -r /tmp/pylock.toml \
    && rm -rf /tmp/cache-warm-venv

# Vast's SSH/Jupyter direct mode replaces the image entrypoint with /.launch,
# but /.launch executes /etc/rc.local. Point that hook at the same entrypoint so
# both modes run Vast's complete /etc/vast_boot.d initialization pipeline. The
# stock base already contains this machinery, so matching the *-auto behavior
# does not require restoring its large CUDA/PyTorch layers.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh \
    && ln -sf /usr/local/bin/entrypoint.sh /etc/rc.local

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []

WORKDIR /workspace
